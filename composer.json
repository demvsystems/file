{
    "name": "demv/file",
    "description": "demv file",
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/demvsystems/file",
    "keywords": [],
    "authors": [
        {
            "name": "DEMV-Systems",
            "email": "packages@demv.de"
        }
    ],
    "require": {
        "php": ">=8.3",
        "dgame/php-ensurance": "^2.0",
        "elephox/mimey": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "codeception/specify": "^2.0.0"
    },
    "autoload": {
        "classmap": [
            "src/"
        ],
        "psr-4": {
            "DEMV\\File\\": "src/",
            "DEMV\\File\\Test\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": [
            "phpunit"
        ],
        "coverage": [
            "phpunit --coverage-clover=coverage"
        ]
    }
}
